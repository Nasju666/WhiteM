# Copy to .env and fill in. Never commit the real .env.

# ── Django ──
SECRET_KEY=change-me
DEBUG=False
DB_NAME=tradinghub
DB_USER=tradinghub_user
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432
CORS_ORIGINS=http://localhost,http://localhost:3000
GUNICORN_WORKERS=3

# ── Blockchain (Base) ──
# Local:        CHAIN_ID=31337, WEB3_PROVIDER_URL=http://127.0.0.1:8545
# Base Sepolia: CHAIN_ID=84532, WEB3_PROVIDER_URL=https://sepolia.base.org (or an Alchemy/Infura URL)
# Base mainnet: CHAIN_ID=8453,  WEB3_PROVIDER_URL=<Alchemy/Infura/QuickNode Base URL>
CHAIN_ID=84532
WEB3_PROVIDER_URL=https://sepolia.base.org
# RPC URL MetaMask should use when adding the network (defaults to the public Base RPC)
PUBLIC_RPC_URL=

# Printed by: cd blockchain && npx hardhat run scripts/deploy.js --network baseSepolia
ESCROW_CONTRACT_ADDRESS=
USDC_TOKEN_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# Dedicated arbiter/deployer wallet. Needs a little ETH on Base for gas.
ARBITER_PRIVATE_KEY=

# Contract parameters, read at deploy time
ESCROW_FEE_BPS=0
ESCROW_AUTO_RELEASE_DAYS=14

# ── Pricing ──
# coingecko = live USDC/PHP rate (cached 10 min); fixed = always PHP_PER_USDC
PRICE_FEED=coingecko
# Fallback rate if the live feed is unreachable
PHP_PER_USDC=63.76
# Optional free CoinGecko demo key for higher rate limits
COINGECKO_API_KEY=
